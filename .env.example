# Copy to .env (gitignored) and fill in:
VOICEAGENT_FRONTIER_URL=https://api.groq.com/openai/v1
VOICEAGENT_FRONTIER_MODEL=qwen/qwen3.8-27b
VOICEAGENT_FRONTIER_KEY=***
# Tenant bundle under data/tenants/ (onboarding = data, not code).
# Unset = built-in demo deployment (a stderr warning says so).
VOICEAGENT_TENANT=
# Default call language for language-routed ASR (e.g. te, ta).
# Unset = blind whisper path (never auto-reroutes).
VOICEAGENT_DEFAULT_LANG=
# Local GGUF model cache dir (default: data/models; registry: data/models/registry.yaml).
VOICEAGENT_MODELS_DIR=data/models
# Comma-separated candidate model stems, tried smallest-first (default: the registry names).
VOICEAGENT_CANDIDATE_MODELS=
# Comma lang:path pairs overriding TTS piper voices, e.g. hi:data/models/hi.onnx (default: built-in VOICE_REGISTRY).
VOICEAGENT_VOICES=
# Embedding space for retrieval (default: latin).
VOICEAGENT_EMBEDDING_SPACE=latin
# Per-client rate limit for the demo chat server's /api/* endpoints:
# <max requests>/<window seconds>, per client IP (429 + Retry-After when over).
# Unset = no rate limiting.
VOICEAGENT_HTTP_RATE_LIMIT=30
VOICEAGENT_HTTP_RATE_WINDOW_S=60
# Set true ONLY behind a trusted reverse proxy (X-Forwarded-For identity);
# default false = socket peer (XFF is client-supplied and spoofable).
VOICEAGENT_TRUST_PROXY=false
# Hugging Face token for gated model downloads (passed to HF-loading call sites; not used yet).
VOICEAGENT_HF_TOKEN=

# --- Real ERP backend (scripts/erp_server.py + src/voiceagent/erp_http.py) ---
# Live calls are backed by a REAL backend over HTTP, never the in-memory
# MockERP fixture. Local dev: run scripts/erp_server.py (stdlib + SQLite,
# seeds from data/tenants/*/erp_fixture.json) and point at it:
#   VOICEAGENT_ERP_URL=http://127.0.0.1:8090
# Production: point at the org's real ERP/CRM base URL (same contract).
# The LiveKit worker refuses to start without this URL (explicit offline
# tests only: VOICEAGENT_ALLOW_MOCK_ERP=1).
VOICEAGENT_ERP_URL=
VOICEAGENT_ERP_TOKEN=
VOICEAGENT_ERP_TIMEOUT=5.0

# --- Data retention & erasure (src/voiceagent/retention.py) ----------------
# Nothing deletes by default. Set a window (days) and run
# scripts/forget_caller.py --purge on a schedule; erase one conversation
# with scripts/forget_caller.py --erase-session <conv_id>.
# Paths: VOICEAGENT_AUDIT_DB / VOICEAGENT_MEMORY_DB / VOICEAGENT_CHAT_MEMORY_DB
# (unset = in-memory only).
VOICEAGENT_DATA_RETENTION_DAYS=
VOICEAGENT_CHAT_MEMORY_DB=

# --- LiveKit telephony limb (scripts/livekit_worker.py + scripts/livekit_dial.py) ---
# Project credentials — LIVEKIT_API_KEY/SECRET is the console spelling; LIVEKIT_KEY/SECRET is accepted as a legacy alias.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Outbound dialing (scripts/livekit_dial.py): DID + trunk ID; room prefix shared with the inbound dispatch rule.
LIVEKIT_NUMBER=
LIVEKIT_TRUNK_ID=
LIVEKIT_ROOM_PREFIX=call-

# Fallback frontier provider (optional). The brain fails over here when the
# primary endpoint errors (429/5xx/unreachable). Any OpenAI-compatible
# /chat/completions endpoint works — e.g. DeepSeek:
#   VOICEAGENT_FRONTIER_FALLBACK_URL=https://api.deepseek.com/v1
#   VOICEAGENT_FRONTIER_FALLBACK_MODEL=deepseek-chat
#   VOICEAGENT_FRONTIER_FALLBACK_KEY=
VOICEAGENT_FRONTIER_FALLBACK_URL=
VOICEAGENT_FRONTIER_FALLBACK_MODEL=
VOICEAGENT_FRONTIER_FALLBACK_KEY=

# --- Amazon Bedrock fallback (optional, Converse API) ---------------------
# Any Converse-served model works (DeepSeek-R1/V3.1, GLM, ...). Auth is AWS
# SigV4 via standard AWS env vars; the model id selects the Bedrock model.
#   VOICEAGENT_BEDROCK_MODEL_ID=zai.glm-4.7-flash
#   VOICEAGENT_BEDROCK_REGION=ap-south-1   (else AWS_REGION / AWS_DEFAULT_REGION)
#   AWS_ACCESS_KEY_ID=
#   AWS_SECRET_ACCESS_KEY=
#   AWS_SESSION_TOKEN=     (only for temporary/SSO creds)
VOICEAGENT_BEDROCK_MODEL_ID=
VOICEAGENT_BEDROCK_REGION=
# Auth: EITHER a Bedrock API key (bearer — recommended, works with Converse)…
VOICEAGENT_BEDROCK_API_KEY=
# …OR IAM creds (SigV4). The API key takes precedence when both are set.
#   AWS_ACCESS_KEY_ID=
#   AWS_SECRET_ACCESS_KEY=
#   AWS_SESSION_TOKEN=
# Optional full Converse URL override (region ignored when set):
# VOICEAGENT_BEDROCK_URL=
