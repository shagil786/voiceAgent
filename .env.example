# Copy to .env (gitignored) and fill in:
VOICEAGENT_FRONTIER_URL=https://api.groq.com/openai/v1
VOICEAGENT_FRONTIER_MODEL=llama-3.3-70b-versatile
VOICEAGENT_FRONTIER_KEY=***
# Tenant bundle under data/tenants/ (onboarding = data, not code).
# Unset = built-in demo deployment (a stderr warning says so).
VOICEAGENT_TENANT=
# Default call language for language-routed ASR (e.g. te, ta).
# Unset = blind whisper path (never auto-reroutes).
VOICEAGENT_DEFAULT_LANG=
# Local GGUF model cache dir (default: data/models; registry: data/models/registry.yaml).
VOICEAGENT_MODELS_DIR=data/models
# Comma-separated candidate model stems, tried smallest-first (default: the registry names).
VOICEAGENT_CANDIDATE_MODELS=
# Comma lang:path pairs overriding TTS piper voices, e.g. hi:data/models/hi.onnx (default: built-in VOICE_REGISTRY).
VOICEAGENT_VOICES=
# Embedding space for retrieval (default: latin).
VOICEAGENT_EMBEDDING_SPACE=latin
# Hugging Face token for gated model downloads (passed to HF-loading call sites; not used yet).
VOICEAGENT_HF_TOKEN=

# --- LiveKit telephony limb (scripts/livekit_worker.py + scripts/livekit_dial.py) ---
# Project credentials — LIVEKIT_API_KEY/SECRET is the console spelling; LIVEKIT_KEY/SECRET is accepted as a legacy alias.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Outbound dialing (scripts/livekit_dial.py): DID + trunk ID; room prefix shared with the inbound dispatch rule.
LIVEKIT_NUMBER=
LIVEKIT_TRUNK_ID=
LIVEKIT_ROOM_PREFIX=call-
